{
  "name": "ejecuttrans/plataforma-herramientas",
  "description": "Plataforma MVC para reportes de pasajeros y exportación de rotativos",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-zip": "*",
    "ext-mbstring": "*",
    "ext-intl": "*",
    "ext-gd": "*",
    "phpoffice/phpspreadsheet": "^3.9 || ^4.0 || ^5.0",
    "dompdf/dompdf": "^3.1"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "config": {"sort-packages": true, "optimize-autoloader": true}
}
